#!/usr/bin/env bash
#
# wine-sandbox - lancia un eseguibile Windows (o winetricks) dentro un
# prefix Wine isolato con bubblewrap.
#
# Modalità:
#   1) Esecuzione gioco (default): rete disabilitata, isolamento massimo.
#      wine-sandbox <prefix> <eseguibile.exe> [argomenti...]
#
#   2) Setup prefix (--setup): rete ABILITATA per winetricks.
#      wine-sandbox --setup <prefix> <verbo_winetricks> [altri verbi...]
#
#   3) Inizializzazione prefix (--init): crea un nuovo prefix Wine con
#      wineboot -u, rete disabilitata, sandbox parziale. Crea la directory
#      se non esiste, rimuove automaticamente l'unità Z: al termine.
#      wine-sandbox --init <prefix> [arch]
#      (arch opzionale: win64, win32; se omesso usa il default WoW64)
#
#   4) Installazione (--install): come modalità gioco ma con Z: abilitata
#      (sola lettura) per permettere all'installer di leggere file esterni
#      (es. setup.exe su disco USB). Filesystem in sola lettura, nessun
#      accesso in scrittura fuori dal prefix. Massima restrizione.
#      wine-sandbox --install <prefix> <setup.exe> [argomenti...]
#
# TOGGLE DI SICUREZZA (variabili d'ambiente, tutte opzionali):
#   SANDBOX_HIDE_HOME=0        Non nascondere la home (di default nascosta)
#   SANDBOX_CAP_DROP=0         Non droppare le capability Linux (di default droppate)
#   SANDBOX_UNSHARE_PID=0      Non isolare la visibilità dei processi (di default isolata)
#   SANDBOX_DRI=0              Non passare /dev/dri, niente accelerazione GPU (di default passato)
#   SANDBOX_AUDIO=0            Non passare i socket audio (di default passati)
#   SANDBOX_ALLOW_LOOPBACK=1   Attiva l'interfaccia di loopback (localhost) pur
#                              restando isolati da internet - utile per giochi
#                              che usano socket locali per componenti interni
#   SANDBOX_ALLOW_NETWORK=1    ⚠️ DISATTIVA l'isolamento di rete. Da usare SOLO
#                              per compatibilità con giochi che richiedono
#                              davvero connessione (raro per abandonware).
#                              Annulla la protezione principale della sandbox.
#   SANDBOX_DISABLE_ZDRIVE=0   Non rimuovere il collegamento all'unità Z: del
#                              prefix (di default rimosso). Z: normalmente
#                              punta alla radice del filesystem visibile nel
#                              namespace della sandbox - va bloccato di default
#                              perché espone tutto ciò che bwrap monta come "/"
#                              (anche se già ristretto, è comunque superficie
#                              extra non necessaria per il gioco).
#   SANDBOX_EXE_RW=1           Permetti scrittura nella cartella del gioco
#                              (di default sola lettura). I giochi abandonware
#                              spesso salvano i salvataggi accanto all'exe;
#                              attiva solo se il gioco non salva nel prefix.
#
# Uso: ./scan-game.sh <url|link_mega|percorso_file_locale> [password_mega]

set -euo pipefail

MAX_DEPTH=5  # non usato qui, resta per compatibilità script scan

INIT_MODE=0
SETUP_MODE=0
INSTALL_MODE=0

if [ "${1:-}" = "--init" ]; then
    INIT_MODE=1
    shift
elif [ "${1:-}" = "--setup" ]; then
    SETUP_MODE=1
    shift
elif [ "${1:-}" = "--install" ]; then
    INSTALL_MODE=1
    shift
fi

if [ "$INIT_MODE" -eq 1 ]; then
    if [ $# -lt 1 ]; then
        echo "Uso: $0 --init <wineprefix> [arch]" >&2
        exit 1
    fi
elif [ $# -lt 2 ]; then
    if [ "$SETUP_MODE" -eq 1 ]; then
        echo "Uso: $0 --setup <wineprefix> <verbo_winetricks> [altri verbi...]" >&2
    else
        echo "Uso: $0 <wineprefix> <eseguibile.exe> [argomenti...]" >&2
    fi
    exit 1
fi

# In modalità --init la directory potrebbe non esistere ancora: la creiamo
# prima di realpath, che altrimenti fallirebbe su path inesistenti.
if [ "$INIT_MODE" -eq 1 ]; then
    mkdir -p "$1"
fi

WINEPFX="$(realpath "$1")"
shift

# Architettura opzionale per --init (win64/win32/vuoto = WoW64 default)
WINEARCH_VAL=""
if [ "$INIT_MODE" -eq 1 ] && [ $# -ge 1 ]; then
    WINEARCH_VAL="$1"
    shift
fi

if [ ! -d "$WINEPFX" ]; then
    echo "Errore: il prefix '$WINEPFX' non esiste." >&2
    exit 1
fi

HIDE_HOME="${SANDBOX_HIDE_HOME:-1}"
CAP_DROP="${SANDBOX_CAP_DROP:-1}"
UNSHARE_PID="${SANDBOX_UNSHARE_PID:-1}"
ALLOW_DRI="${SANDBOX_DRI:-1}"
ALLOW_AUDIO="${SANDBOX_AUDIO:-1}"
ALLOW_LOOPBACK="${SANDBOX_ALLOW_LOOPBACK:-0}"
ALLOW_NETWORK="${SANDBOX_ALLOW_NETWORK:-0}"
DISABLE_ZDRIVE="${SANDBOX_DISABLE_ZDRIVE:-1}"
EXE_RW="${SANDBOX_EXE_RW:-0}"

if [ "$DISABLE_ZDRIVE" -eq 1 ] && [ -e "$WINEPFX/dosdevices/z:" ]; then
    rm -f "$WINEPFX/dosdevices/z:"
    echo "   Unità Z: rimossa dal prefix (bloccato l'accesso alla radice filesystem)"
fi

PULSE_SOCKET="/run/user/$(id -u)/pulse/native"
PIPEWIRE_SOCKET="/run/user/$(id -u)/pipewire-0"

BWRAP_ARGS+=(
    --unshare-ipc
    --unshare-uts
    --die-with-parent
    --new-session
)

[ "$UNSHARE_PID" -eq 1 ] && BWRAP_ARGS+=(--unshare-pid)
if [ "$CAP_DROP" -eq 1 ]; then
    if [ "$ALLOW_DRI" -eq 1 ]; then
        # Con GPU attiva, droppa tutto tranne CAP_SYS_ADMIN: serve per
        # l'autenticazione DRM (amdgpu/radeon richiedono drmAuth).
        BWRAP_ARGS+=(--cap-drop ALL --cap-add CAP_SYS_ADMIN)
    else
        BWRAP_ARGS+=(--cap-drop ALL)
    fi
fi

# Rete disabilitata in modalità gioco e init; abilitata solo in --setup
if [ "$ALLOW_NETWORK" -eq 0 ] && [ "$SETUP_MODE" -eq 0 ]; then
    BWRAP_ARGS+=(--unshare-net)
    NET_ISOLATED=1
else
    NET_ISOLATED=0
fi

BWRAP_ARGS+=(
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --ro-bind /lib /lib
    --ro-bind-try /lib64 /lib64
    --ro-bind-try /opt /opt
    --symlink /usr/bin /bin
    --proc /proc
    --dev /dev
)

# Masking di file sensibili in /proc.
# I FILE (kcore, kallsyms, sysrq-trigger) vanno mascherati con --ro-bind
# /dev/null (tmpfs non funziona su un file). Le DIRECTORY (bus, scsi) con tmpfs.
BWRAP_ARGS+=(
    --ro-bind /dev/null /proc/kcore
    --ro-bind /dev/null /proc/kallsyms
    --ro-bind /dev/null /proc/sysrq-trigger
    --tmpfs /proc/bus
    --tmpfs /proc/scsi
)

# /proc/sys in sola lettura (contiene parametri kernel tweakabili)
BWRAP_ARGS+=(--ro-bind /proc/sys /proc/sys)

# Masking di directory del filesystem non necessarie al gioco
# (impedisce accessi a /var, /mnt, /srv, /boot, /media anche se esistono)
BWRAP_ARGS+=(
    --tmpfs /var
    --tmpfs /mnt
    --tmpfs /srv
    --tmpfs /boot
    --tmpfs /media
)

# Masking di file sensibili in /etc
BWRAP_ARGS+=(
    --ro-bind /dev/null /etc/machine-id
    --ro-bind /dev/null /etc/hostname
    --ro-bind /dev/null /etc/fstab
    --ro-bind /dev/null /etc/crypttab
    --ro-bind /dev/null /etc/shadow
    --ro-bind /dev/null /etc/gshadow
)

[ "$ALLOW_DRI" -eq 1 ] && BWRAP_ARGS+=(--dev-bind-try /dev/dri /dev/dri)

# Mesa/Vulkan hanno bisogno di /sys per enumerare le GPU fisiche:
# - /sys/class/drm: elenco dei device DRM (card0, renderD128, ecc.)
# - /sys/dev/char: mappatura major:minor → device path (serve al loader)
# Senza questi, il loader Mesa fallisce con "failed to retrieve device
# information" e Vulkan con "init_physical_devices failed".
if [ "$ALLOW_DRI" -eq 1 ]; then
    BWRAP_ARGS+=(
        --ro-bind-try /sys/class/drm /sys/class/drm
        --ro-bind-try /sys/dev/char /sys/dev/char
    )
fi

if [ "$HIDE_HOME" -eq 1 ]; then
    BWRAP_ARGS+=(--tmpfs /home --tmpfs /root)
else
    BWRAP_ARGS+=(--bind "$HOME" "$HOME")
fi

# /run/media (dischi rimovibili/USB): bind-mount in sola lettura PRIMA del
# prefix, così il --bind $WINEPFX successivo (più specifico) lo sovrascrive
# con accesso in scrittura. L'ordine dei mount in bwrap conta: i path più
# specifici dichiarati dopo vincono su quelli più generici dichiarati prima.
[ -d /run/media ] && BWRAP_ARGS+=(--ro-bind-try /run/media /run/media)

# Il prefix va bind-mountato DOPO /run/media (e qualsiasi altro mount broad)
# così l'accesso in scrittura al prefix sovrascrive l'eventuale ro-bind del
# parent. Questo è critico quando il prefix si trova su un disco USB.
BWRAP_ARGS+=(--bind "$WINEPFX" "$WINEPFX" --tmpfs /tmp --tmpfs "/run/user/$(id -u)")

if [ "$ALLOW_AUDIO" -eq 1 ]; then
    [ -S "$PIPEWIRE_SOCKET" ] && BWRAP_ARGS+=(--bind "$PIPEWIRE_SOCKET" "$PIPEWIRE_SOCKET")
    [ -S "$PULSE_SOCKET" ] && BWRAP_ARGS+=(--bind "$PULSE_SOCKET" "$PULSE_SOCKET")
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "/run/user/$(id -u)/${WAYLAND_DISPLAY}" ]; then
    BWRAP_ARGS+=(--bind "/run/user/$(id -u)/${WAYLAND_DISPLAY}" "/run/user/$(id -u)/${WAYLAND_DISPLAY}")
fi
if [ -n "${DISPLAY:-}" ] && [ -d /tmp/.X11-unix ]; then
    BWRAP_ARGS+=(--ro-bind /tmp/.X11-unix /tmp/.X11-unix)
fi

if [ "$SETUP_MODE" -eq 1 ] && [ -d "$HOME/.cache/winetricks" ]; then
    BWRAP_ARGS+=(--bind "$HOME/.cache/winetricks" "$HOME/.cache/winetricks")
fi

if [ "$SETUP_MODE" -eq 0 ] && [ "$INIT_MODE" -eq 0 ]; then
    EXE="$(realpath "$1")"
    shift
    EXE_DIR="$(dirname "$EXE")"

    # Se EXE_DIR è dentro il prefix, il --bind $WINEPFX già lo copre.
    # Non aggiungere un mount separato: sovrascriverebbe l'accesso in
    # scrittura del prefix (read-only su un path che era read-write).
    EXE_IN_PREFIX=0
    case "$EXE_DIR" in
        "$WINEPFX"/*) EXE_IN_PREFIX=1 ;;
    esac

    if [ "$INSTALL_MODE" -eq 1 ]; then
        # Modalità installazione: EXE_DIR in sola lettura (l'installer legge,
        # non scrive nella cartella sorgente). Z: abilitata ma tutti i mount
        # sono già ro-bind, quindi l'installer non può scrivere fuori dal prefix.
        if [ "$EXE_IN_PREFIX" -eq 0 ]; then
            BWRAP_ARGS+=(--ro-bind "$EXE_DIR" "$EXE_DIR")
        fi
        # Assicura che Z: esista per questa sessione (Wine la usa per risolvere
        # i path Unix dei file sorgente).
        if [ ! -e "$WINEPFX/dosdevices/z:" ]; then
            ln -sf / "$WINEPFX/dosdevices/z:"
        fi
        echo ">> Installazione in sandbox: $EXE"
        echo "   Rete: DISABILITATA"
        echo "   Home: nascosta"
        echo "   Z: abilitata (sola lettura - l'installer vede i file sorgente)"
        echo "   Filesystem: SOLO LETTURA (scrittura solo nel prefix)"
    else
        # Modalità gioco: EXE_DIR in sola lettura di default (il gioco non
        # deve scrivere nella sua cartella di installazione). SANDBOX_EXE_RW=1
        # permette scrittura per giochi che salvano i salvataggi accanto all'exe.
        # Se l'exe è dentro il prefix, il --bind $WINEPFX già gestisce l'accesso
        # (read-write), non serve un mount separato.
        if [ "$EXE_IN_PREFIX" -eq 1 ]; then
            echo ">> Avvio in sandbox: $EXE"
            echo "   (exe dentro il prefix - accesso gestito dal mount del prefix)"
        elif [ "$EXE_RW" -eq 1 ]; then
            BWRAP_ARGS+=(--bind "$EXE_DIR" "$EXE_DIR")
            echo ">> Avvio in sandbox: $EXE"
            echo "   Cartella gioco: ⚠️ scrittura abilitata"
        else
            BWRAP_ARGS+=(--ro-bind "$EXE_DIR" "$EXE_DIR")
            echo ">> Avvio in sandbox (read-only): $EXE"
            echo "   Cartella gioco: sola lettura"
        fi
        [ "$NET_ISOLATED" -eq 1 ] && echo "   Rete: DISABILITATA" || echo "   Rete: ⚠️ ABILITATA (compatibilità)"
        [ "$HIDE_HOME" -eq 1 ] && echo "   Home: nascosta" || echo "   Home: ⚠️ visibile (compatibilità)"
    fi
elif [ "$INIT_MODE" -eq 1 ]; then
    echo ">> Inizializzazione prefix in sandbox: $WINEPFX"
    echo "   Rete: DISABILITATA"
    [ "$HIDE_HOME" -eq 1 ] && echo "   Home: nascosta" || echo "   Home: ⚠️ visibile (compatibilità)"
    [ -n "$WINEARCH_VAL" ] && echo "   Architettura: $WINEARCH_VAL" || echo "   Architettura: WoW64 (predefinita)"
fi

COMMON_ENV=(
    env
    WINEPREFIX="$WINEPFX"
    DISPLAY="${DISPLAY:-}"
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}"
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    PULSE_SERVER="unix:$PULSE_SOCKET"
)
# XAUTHORITY: necessario per connettersi al server X (XWayland). Senza questo,
# Wine non può aprire finestre e fallisce con "Authorization required".
if [ -n "${XAUTHORITY:-}" ]; then
    COMMON_ENV+=(XAUTHORITY="$XAUTHORITY")
    # Assicuriamoci che il file xauth sia visibile dentro la sandbox
    [ -f "$XAUTHORITY" ] && BWRAP_ARGS+=(--ro-bind-try "$XAUTHORITY" "$XAUTHORITY")
fi
# WINEARCH viene impostato SOLO in modalità --init: è l'unico momento in cui
# conta (creazione del prefix). Su un prefix già esistente, wine legge
# l'architettura registrata al suo interno. Forzarlo ad ogni esecuzione
# romperebbe i prefix su build Wine moderne "WoW64-only" (Wine 10+).
if [ "$INIT_MODE" -eq 1 ] && [ -n "$WINEARCH_VAL" ]; then
    COMMON_ENV+=(WINEARCH="$WINEARCH_VAL")
fi

if [ "$INIT_MODE" -eq 1 ]; then
    exec bwrap "${BWRAP_ARGS[@]}" "${COMMON_ENV[@]}" wineboot -u
    # Dopo wineboot, la GUI rimuove Z: se SANDBOX_DISABLE_ZDRIVE è attivo
elif [ "$SETUP_MODE" -eq 1 ]; then
    exec bwrap "${BWRAP_ARGS[@]}" "${COMMON_ENV[@]}" winetricks "$@"
else
    if [ "$NET_ISOLATED" -eq 1 ] && [ "$ALLOW_LOOPBACK" -eq 1 ]; then
        # Attiva l'interfaccia di loopback nel nuovo network namespace (nessun
        # accesso a internet, ma localhost funziona per giochi che usano
        # socket locali per componenti interni - es. alcuni motori audio/video)
        exec bwrap "${BWRAP_ARGS[@]}" "${COMMON_ENV[@]}" \
            sh -c 'ip link set lo up 2>/dev/null; exec wine "$0" "$@"' "$EXE" "$@"
    else
        exec bwrap "${BWRAP_ARGS[@]}" "${COMMON_ENV[@]}" wine "$EXE" "$@"
    fi
fi
