#!/usr/bin/env bash
#
# wine-sandbox - lancia un eseguibile Windows (o winetricks) dentro un
# prefix Wine isolato con bubblewrap.
#
# Modalità:
#   1) Esecuzione gioco (default): rete disabilitata, isolamento massimo.
#      wine-sandbox <prefix> <eseguibile.exe> [argomenti...]
#
#   2) Setup prefix (--setup): rete ABILITATA per winetricks.
#      wine-sandbox --setup <prefix> <verbo_winetricks> [altri verbi...]
#
#   3) Inizializzazione prefix (--init): crea un nuovo prefix Wine con
#      wineboot -u, rete disabilitata, sandbox parziale. Crea la directory
#      se non esiste, rimuove automaticamente l'unità Z: al termine.
#      wine-sandbox --init <prefix> [arch]
#      (arch opzionale: win64, win32; se omesso usa il default WoW64)
#
#   4) Installazione (--install): come modalità gioco ma con Z: abilitata
#      (sola lettura) per permettere all'installer di leggere file esterni
#      (es. setup.exe su disco USB). Filesystem in sola lettura, nessun
#      accesso in scrittura fuori dal prefix. Massima restrizione.
#      wine-sandbox --install <prefix> <setup.exe> [argomenti...]
#
#   Opzione --runtime: specifica un runtime Wine/Proton personalizzato.
#      wine-sandbox --runtime <DIR> [--init|--setup|--install] <prefix> <exe/verbi...>
#      <DIR> è la root di un compatibility tool Proton (es.
#      /usr/share/steam/compatibilitytools.d/proton-cachyos-native).
#      Se omesso, usa wine/wineserver di sistema.
#
# TOGGLE DI SICUREZZA (variabili d'ambiente, tutte opzionali):
#   SANDBOX_HIDE_HOME=0        Non nascondere la home (di default nascosta)
#   SANDBOX_CAP_DROP=0         Non droppare le capability Linux (di default droppate)
#   SANDBOX_UNSHARE_PID=0      Non isolare la visibilità dei processi (di default isolata)
#   SANDBOX_WAYLAND_ONLY=1     Espone SOLO Wayland, mai X11 (DI DEFAULT ON). X11 è il
#                              vettore di sicurezza peggiore (un qualsiasi client X11 può
#                              intercettare tastiera/screenshot di tutte le finestre,
#                              sandbox o no): escluderlo elimina questa classe di attacchi.
#                              Richiede Wine >= 10 con driver nativo Wayland
#                              (winewayland.drv) e una sessione Wayland attiva
#                              (WAYLAND_DISPLAY). Alcuni giochi legacy potrebbero non essere
#                              supportati dal driver nativo: in quel caso usa
#                              SANDBOX_WAYLAND_ONLY=0 (X11/XWayland).
#   SANDBOX_X11_FALLBACK=1     Fallback X11/XWayland esplicito per giochi legacy non
#                              supportati dal driver Wayland nativo (finestre GDI/GL,
#                              es. titoli DirectX8-era). Vince su SANDBOX_WAYLAND_ONLY
#                              e neutralizza anche un eventuale SANDBOX_UNSHARE_IPC=1
#                              (in X11 spezzerebbe MIT-SHM). MENO SICURO di Wayland:
#                              un client X11 può intercettare tastiera/screenshot di
#                              altre app X11 (XWayland); la sandbox bwrap resta però
#                              attiva (rete off, capability droppate, home nascosta).
#                              Va usato solo per titoli che col driver nativo non girano.
#   SANDBOX_UNSHARE_IPC=0      Disattiva l'isolamento dei segmenti IPC condivisi
#                              (SysV shm/sem/msg). ATTIVO di default: con il driver nativo
#                              Wayland non c'è X11/MIT-SHM, quindi non rompe nulla. Serve
#                              solo in modalità X11 (SANDBOX_WAYLAND_ONLY=0), dove isolare
#                              i segmenti SysV fa crashare i giochi che usano MIT-SHM.
#   SANDBOX_DRI=0              Non passare /dev/dri, niente accelerazione GPU (di default passato)
#   SANDBOX_GPU_CAP_SYSADMIN=1 Espone /dev/dri/cardN intero (invece del solo
#                              render node) e aggiunge CAP_SYS_ADMIN, necessario
#                              per il DRM master authentication di alcuni
#                              driver legacy. Di default OFF: si usa solo il
#                              render node (/dev/dri/renderD1XX) che permette
#                              rendering/compute GPU senza privilegi speciali.
#   SANDBOX_AUDIO=0            Non passare i socket audio (di default passati)
#   SANDBOX_ALLOW_LOOPBACK=1   Attiva l'interfaccia di loopback (localhost) pur
#                              restando isolati da internet - utile per giochi
#                              che usano socket locali per componenti interni
#   SANDBOX_ALLOW_NETWORK=1    ⚠️ DISATTIVA l'isolamento di rete. Da usare SOLO
#                              per compatibilità con giochi che richiedono
#                              davvero connessione (raro per abandonware).
#                              Annulla la protezione principale della sandbox.
#   SANDBOX_DISABLE_ZDRIVE=0   Non rimuovere il collegamento all'unità Z: del
#                              prefix (di default rimosso). Z: normalmente
#                              punta alla radice del filesystem visibile nel
#                              namespace della sandbox - va bloccato di default
#                              perché espone tutto ciò che bwrap monta come "/"
#                              (anche se già ristretto, è comunque superficie
#                              extra non necessaria per il gioco).
#   SANDBOX_EXE_RW=1           Permetti scrittura nella cartella del gioco
#                              (di default sola lettura). I giochi abandonware
#                              spesso salvano i salvataggi accanto all'exe;
#                              attiva solo se il gioco non salva nel prefix.
#   SANDBOX_GAMEPAD=0          Non esporre i device di input (/dev/input e
#                              /run/udev/data). Di default ON (1): i gamepad
#                              sono dispositivi di input come tastiera/mouse,
#                              già accessibili via Wayland/X11. Serve per
#                              l'enumerazione device via evdev/SDL2/libudev.
#   SANDBOX_VIRTUAL_DESKTOP=1  Avvia il gioco in un desktop virtuale Wine
#                              (finestra invece di fullscreen). Utile per
#                              giochi che bloccano lo schermo con schermo nero
#                              o per debug. Risoluzione controllabile via
#                              SANDBOX_VIRTUAL_DESKTOP_SIZE (default 1280x720).
#
# HARDENING SEMPRE ATTIVO (non disattivabile, nessun impatto sui giochi):
#   --unshare-cgroup-try  Isola la vista dei cgroup (nessun gioco ne ha bisogno)
#   /etc/ssh mascherata    Nessuna chiave host SSH visibile al gioco
#
# NOTA: --disable-userns (blocco user namespace annidati) è stato valutato ma
# NON è attivo: richiede --unshare-user, che a sua volta fallisce su sistemi
# con user namespace non privilegiati disabilitati via sysctl
# (kernel.unprivileged_userns_clone=0, es. alcune distro hardened/Debian).
# Il rischio di rompere la sandbox ovunque su quei sistemi supera il beneficio
# di sicurezza marginale contro un vettore di attacco già mitigato da
# --cap-drop ALL (senza CAP_SYS_ADMIN un gioco non privilegiato non può
# comunque creare user namespace annidati in molte configurazioni kernel).
#   GPU via render node    Solo /dev/dri/renderD1XX esposto di default (non
#                          card0): rendering/compute GPU senza CAP_SYS_ADMIN
#
# ESPOSIZIONE DI /sys (read-only, sempre attiva):
#   --ro-bind /sys /sys   Wine/Mesa hanno bisogno di /sys per enumerare CPU
#   (topology in /sys/devices/system/cpu) e GPU (bus PCI in /sys/devices/pci*,
#   device DRM in /sys/class/drm, mappatura major:minor in /sys/dev/char).
#   Senza /sys completo Wine fallisce la rilevazione della scheda e casca su
#   llvmpipe (rendering software), il che rompe molti giochi 3D anche in
#   modalità "GPU spenta" (il page fault del log è questo).
#   Sicurezza: --ro-bind è read-only A LIVELLO DI MOUNT (nessuna scrittura
#   possibile nemmeno con capability), il gioco gira come utente non-root con
#   --cap-drop ALL, e l'esposizione è limitata a metadati hardware (comparable
#   a /proc già montato). Stesso approccio di Steam/Flatpak per l'accelerazione
#   GPU dentro i namespace. /sys/kernel/security (securityfs LSM) è mascherato
#   con tmpfs vuota perché può contenere policy e stato degli LSM.
#
# Uso: ./scan-game.sh <url|link_mega|percorso_file_locale> [password_mega]

set -euo pipefail

MAX_DEPTH=5  # non usato qui, resta per compatibilità script scan

INIT_MODE=0
SETUP_MODE=0
INSTALL_MODE=0
RUNTIME=""

# Opzione --runtime: percorso a un runtime Proton (es. Proton CachyOS).
# Se specificato, WINE/WINESERVER vengono sovrascritti e LD_LIBRARY_PATH
# include i .so del runtime.
if [ "${1:-}" = "--runtime" ]; then
    if [ $# -lt 2 ]; then
        echo "Uso: $0 --runtime <DIR> [--init|--setup|--install] <prefix> <exe/verbi...>" >&2
        exit 1
    fi
    RUNTIME="$2"
    shift 2
fi

if [ "${1:-}" = "--init" ]; then
    INIT_MODE=1
    shift
elif [ "${1:-}" = "--setup" ]; then
    SETUP_MODE=1
    shift
elif [ "${1:-}" = "--install" ]; then
    INSTALL_MODE=1
    shift
fi

if [ "$INIT_MODE" -eq 1 ]; then
    if [ $# -lt 1 ]; then
        echo "Uso: $0 --init <wineprefix> [arch]" >&2
        exit 1
    fi
elif [ $# -lt 2 ]; then
    if [ "$SETUP_MODE" -eq 1 ]; then
        echo "Uso: $0 --setup <wineprefix> <verbo_winetricks> [altri verbi...]" >&2
    else
        echo "Uso: $0 <wineprefix> <eseguibile.exe> [argomenti...]" >&2
    fi
    exit 1
fi

# In modalità --init la directory potrebbe non esistere ancora: la creiamo
# prima di realpath, che altrimenti fallirebbe su path inesistenti.
if [ "$INIT_MODE" -eq 1 ]; then
    mkdir -p "$1"
fi

WINEPFX="$(realpath "$1")"
shift

# Architettura opzionale per --init (win64/win32/vuoto = WoW64 default)
WINEARCH_VAL=""
if [ "$INIT_MODE" -eq 1 ] && [ $# -ge 1 ]; then
    WINEARCH_VAL="$1"
    shift
fi

if [ ! -d "$WINEPFX" ]; then
    echo "Errore: il prefix '$WINEPFX' non esiste." >&2
    exit 1
fi

HIDE_HOME="${SANDBOX_HIDE_HOME:-1}"
CAP_DROP="${SANDBOX_CAP_DROP:-1}"
UNSHARE_PID="${SANDBOX_UNSHARE_PID:-1}"
WAYLAND_ONLY="${SANDBOX_WAYLAND_ONLY:-1}"
X11_FALLBACK="${SANDBOX_X11_FALLBACK:-0}"
# --unshare-ipc in modo Wayland-only: con il driver nativo Wayland (winewayland.drv)
# non esiste più X11/MIT-SHM (il rendering va via EGL/Vulkan al compositor), quindi
# isolare i segmenti SysV è sicuro e viene abilitato di default. Disattivalo con
# SANDBOX_UNSHARE_IPC=0 se un gioco dovesse usare memoria condivisa SysV esterna.
if [ "$WAYLAND_ONLY" -eq 1 ] && [ -z "${SANDBOX_UNSHARE_IPC:-}" ]; then
    UNSHARE_IPC=1
else
    UNSHARE_IPC="${SANDBOX_UNSHARE_IPC:-0}"
fi

# Fallback X11/XWayland esplicito: override per giochi legacy non supportati dal
# driver nativo Wayland (finestre GDI/GL). Vince su WAYLAND_ONLY e neutralizza un
# eventuale UNSHARE_IPC=1 (in X11 isolare i segmenti SysV spezza MIT-SHM → crash).
if [ "$X11_FALLBACK" -eq 1 ]; then
    WAYLAND_ONLY=0
    UNSHARE_IPC=0
fi
# --setup (winetricks): tool fidato, ma è una GUI GDI non supportata dal driver
# Wayland nativo. Forziamo X11 automaticamente senza bisogno di toggle manuale.
if [ "$SETUP_MODE" -eq 1 ] && [ "$WAYLAND_ONLY" -eq 1 ]; then
    WAYLAND_ONLY=0
    UNSHARE_IPC=0
fi
ALLOW_DRI="${SANDBOX_DRI:-1}"
GPU_CAP_SYSADMIN="${SANDBOX_GPU_CAP_SYSADMIN:-0}"
ALLOW_AUDIO="${SANDBOX_AUDIO:-1}"
ALLOW_LOOPBACK="${SANDBOX_ALLOW_LOOPBACK:-0}"
ALLOW_NETWORK="${SANDBOX_ALLOW_NETWORK:-0}"
DISABLE_ZDRIVE="${SANDBOX_DISABLE_ZDRIVE:-1}"
EXE_RW="${SANDBOX_EXE_RW:-0}"
GAMEPAD="${SANDBOX_GAMEPAD:-1}"
VIRTUAL_DESKTOP="${SANDBOX_VIRTUAL_DESKTOP:-0}"
VIRTUAL_DESKTOP_SIZE="${SANDBOX_VIRTUAL_DESKTOP_SIZE:-1280x720}"

# Runtime Wine personalizzato (Proton/Proton-CachyOS): override wine/wineserver
# e prepende le librerie del runtime a LD_LIBRARY_PATH (necessarie per trovare
# ntdll.so e gli altri .so di Wine/Proton).
if [ -n "$RUNTIME" ]; then
    if [ ! -d "$RUNTIME/files/bin" ]; then
        echo "Errore: runtime '$RUNTIME' non trovato o struttura non valida (manca files/bin/)." >&2
        exit 1
    fi
    export WINE="$RUNTIME/files/bin/wine"
    export WINESERVER="$RUNTIME/files/bin/wineserver"
    export LD_LIBRARY_PATH="$RUNTIME/files/lib:$RUNTIME/files/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    # Opzioni runtime Proton (ereditate dall'ambiente o default)
    export PROTON_USE_WINED3D="${PROTON_USE_WINED3D:-0}"
    export PROTON_DXVK_D3D8="${PROTON_DXVK_D3D8:-0}"
    export PROTON_NO_FSYNC="${PROTON_NO_FSYNC:-0}"
    export PROTON_NO_NTSYNC="${PROTON_NO_NTSYNC:-0}"
    export PROTON_FORCE_LARGE_ADDRESS_AWARE="${PROTON_FORCE_LARGE_ADDRESS_AWARE:-1}"
    echo "   Runtime: $RUNTIME"
fi

if [ "$DISABLE_ZDRIVE" -eq 1 ] && [ -e "$WINEPFX/dosdevices/z:" ]; then
    rm -f "$WINEPFX/dosdevices/z:"
    echo "   Unità Z: rimossa dal prefix (bloccato l'accesso alla radice filesystem)"
fi

PULSE_SOCKET="/run/user/$(id -u)/pulse/native"
PIPEWIRE_SOCKET="/run/user/$(id -u)/pipewire-0"

BWRAP_ARGS+=(
    --unshare-uts
    --unshare-cgroup-try
    --die-with-parent
    --new-session
)

# --unshare-ipc: isola i segmenti IPC condivisi (SysV shm/sem/msg) dal resto del
# sistema. Disattivo SOLO in modalità X11, perché spezza la memoria condivisa X11
# MIT-SHM (X_ShmPutImage) usata da moltissimi giochi: il server X (nell'host) non
# vede i segmenti SysV del gioco → BadValue/crash "Unhandled page fault". Con
# SANDBOX_WAYLAND_ONLY=1 (default) il rendering non passa più da X11, quindi
# --unshare-ipc è attivo. Forza SANDBOX_UNSHARE_IPC=0 se un gioco usa memoria
# condivisa SysV esterna.
[ "$UNSHARE_IPC" -eq 1 ] && BWRAP_ARGS+=(--unshare-ipc)

[ "$UNSHARE_PID" -eq 1 ] && BWRAP_ARGS+=(--unshare-pid)
if [ "$CAP_DROP" -eq 1 ]; then
    if [ "$ALLOW_DRI" -eq 1 ] && [ "$GPU_CAP_SYSADMIN" -eq 1 ]; then
        # Con GPU attiva e toggle esplicito, droppa tutto tranne CAP_SYS_ADMIN:
        # serve per l'autenticazione DRM (amdgpu/radeon richiedono drmAuth).
        BWRAP_ARGS+=(--cap-drop ALL --cap-add CAP_SYS_ADMIN)
    else
        BWRAP_ARGS+=(--cap-drop ALL)
    fi
fi

# Rete disabilitata in modalità gioco e init; abilitata solo in --setup
if [ "$ALLOW_NETWORK" -eq 0 ] && [ "$SETUP_MODE" -eq 0 ]; then
    BWRAP_ARGS+=(--unshare-net)
    NET_ISOLATED=1
else
    NET_ISOLATED=0
fi

BWRAP_ARGS+=(
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --ro-bind /lib /lib
    --ro-bind-try /lib64 /lib64
    --symlink usr/lib32 /lib32
    --ro-bind-try /opt /opt
    --symlink /usr/bin /bin
    --proc /proc
    --dev /dev
    # /sys intero in sola lettura (sempre): Wine/Mesa lo usano per enumerare
    # CPU e GPU. Senza, Wine casca su llvmpipe e molti giochi 3D crashano
    # (vedi commento nell'header). Read-only a livello di mount, sicuro.
    --ro-bind /sys /sys
    --tmpfs /sys/kernel/security
)

# Masking di file sensibili in /proc.
# I FILE (kcore, kallsyms, sysrq-trigger) vanno mascherati con --ro-bind
# /dev/null (tmpfs non funziona su un file). Le DIRECTORY (bus, scsi) con tmpfs.
# I file che potrebbero non esistere su tutti i kernel (config.gz, sched_debug,
# modules) vanno verificati con test -e prima del bind: --ro-bind-try non aiuta
# perché controlla l'esistenza della sorgente, non della destinazione.
BWRAP_ARGS+=(
    --ro-bind /dev/null /proc/kcore
    --ro-bind /dev/null /proc/kallsyms
    --ro-bind /dev/null /proc/sysrq-trigger
    --tmpfs /proc/bus
    --tmpfs /proc/scsi
)
# File /proc opzionali (dipendono dalla configurazione del kernel)
[ -e /proc/modules ] && BWRAP_ARGS+=(--ro-bind /dev/null /proc/modules)
[ -e /proc/config.gz ] && BWRAP_ARGS+=(--ro-bind /dev/null /proc/config.gz)
[ -e /proc/sched_debug ] && BWRAP_ARGS+=(--ro-bind /dev/null /proc/sched_debug)

# /proc/sys in sola lettura (contiene parametri kernel tweakabili)
BWRAP_ARGS+=(--ro-bind /proc/sys /proc/sys)

# Masking di directory del filesystem non necessarie al gioco
# (impedisce accessi a /var, /mnt, /srv, /boot, /media anche se esistono)
BWRAP_ARGS+=(
    --tmpfs /var
    --tmpfs /mnt
    --tmpfs /srv
    --tmpfs /boot
    --tmpfs /media
)

# Masking di file sensibili in /etc
BWRAP_ARGS+=(
    --ro-bind /dev/null /etc/machine-id
    --ro-bind /dev/null /etc/hostname
    --ro-bind /dev/null /etc/fstab
    --ro-bind /dev/null /etc/crypttab
    --ro-bind /dev/null /etc/shadow
    --ro-bind /dev/null /etc/gshadow
    --tmpfs /etc/ssh
)

if [ "$ALLOW_DRI" -eq 1 ]; then
    if [ "$GPU_CAP_SYSADMIN" -eq 1 ]; then
        # Modalità compatibilità: espone /dev/dri intero (card0 incluso).
        # card0 richiede DRM master (drmAuth), quindi serve CAP_SYS_ADMIN.
        BWRAP_ARGS+=(--dev-bind-try /dev/dri /dev/dri)
    else
        # Modalità sicura (default): espone SOLO i render node
        # (/dev/dri/renderD1XX). I render node fanno rendering/compute GPU
        # senza bisogno di essere DRM master: nessun CAP_SYS_ADMIN richiesto.
        # Lo scanout/display resta gestito dal compositor sull'host.
        for node in /dev/dri/renderD*; do
            [ -e "$node" ] && BWRAP_ARGS+=(--dev-bind-try "$node" "$node")
        done
    fi
fi

# Gamepad e dispositivi di input: /dev/input (evdev + joystick legacy) per
# SDL2/Wine; /run/udev/data per l'enumerazione device via libudev (metadati
# vendor/prodotto). I gamepad sono dispositivi di input al pari di
# tastiera/mouse, già accessibili via Wayland/X11: default ON.
if [ "$GAMEPAD" -eq 1 ]; then
    [ -d /dev/input ] && BWRAP_ARGS+=(--dev-bind-try /dev/input /dev/input)
    [ -d /run/udev/data ] && BWRAP_ARGS+=(--ro-bind-try /run/udev/data /run/udev/data)
fi

# NOTA: /sys (inclusi /sys/class/drm e /sys/dev/char per l'enumerazione GPU
# Mesa/Vulkan) è già montato intero e read-only nella sezione base qui sopra.

if [ "$HIDE_HOME" -eq 1 ]; then
    BWRAP_ARGS+=(--tmpfs /home --tmpfs /root)
else
    BWRAP_ARGS+=(--bind "$HOME" "$HOME")
fi

# /run/media (dischi rimovibili/USB): bind-mount in sola lettura PRIMA del
# prefix, così il --bind $WINEPFX successivo (più specifico) lo sovrascrive
# con accesso in scrittura. L'ordine dei mount in bwrap conta: i path più
# specifici dichiarati dopo vincono su quelli più generici dichiarati prima.
[ -d /run/media ] && BWRAP_ARGS+=(--ro-bind-try /run/media /run/media)

# Il prefix va bind-mountato DOPO /run/media (e qualsiasi altro mount broad)
# così l'accesso in scrittura al prefix sovrascrive l'eventuale ro-bind del
# parent. Questo è critico quando il prefix si trova su un disco USB.
BWRAP_ARGS+=(--bind "$WINEPFX" "$WINEPFX" --tmpfs /tmp --tmpfs "/run/user/$(id -u)")

if [ "$ALLOW_AUDIO" -eq 1 ]; then
    [ -S "$PIPEWIRE_SOCKET" ] && BWRAP_ARGS+=(--bind "$PIPEWIRE_SOCKET" "$PIPEWIRE_SOCKET")
    [ -S "$PULSE_SOCKET" ] && BWRAP_ARGS+=(--bind "$PULSE_SOCKET" "$PULSE_SOCKET")
fi

if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "/run/user/$(id -u)/${WAYLAND_DISPLAY}" ]; then
    BWRAP_ARGS+=(--bind "/run/user/$(id -u)/${WAYLAND_DISPLAY}" "/run/user/$(id -u)/${WAYLAND_DISPLAY}")
fi
# In modalità Wayland-puro (SANDBOX_WAYLAND_ONLY=1) NON esponiamo il socket X11
# e non passiamo XAUTHORITY: il gioco può connettersi solo al compositor Wayland.
# X11 è il vettore di sicurezza peggiore (qualunque client X11 può intercettare
# tastiera/screenshot di tutte le finestre): escluderlo elimina questa classe di
# attacchi. Compromesso: serve Wine >= 10 con driver nativo Wayland (winewayland.drv),
# e alcuni giochi legacy potrebbero non essere ancora supportati dal driver nativo.
if [ "$WAYLAND_ONLY" -eq 1 ]; then
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "/run/user/$(id -u)/${WAYLAND_DISPLAY}" ]; then
        echo "   Display: SOLO Wayland (X11 non esposto)"
    else
        echo "ERRORE: SANDBOX_WAYLAND_ONLY=1 ma il socket Wayland non è disponibile." >&2
        echo "       Sessione Wayland richiesta (WAYLAND_DISPLAY non impostato)." >&2
        exit 1
    fi
elif [ -n "${DISPLAY:-}" ] && [ -d /tmp/.X11-unix ]; then
    BWRAP_ARGS+=(--ro-bind /tmp/.X11-unix /tmp/.X11-unix)
fi

if [ "$SETUP_MODE" -eq 1 ] && [ -d "$HOME/.cache/winetricks" ]; then
    BWRAP_ARGS+=(--bind "$HOME/.cache/winetricks" "$HOME/.cache/winetricks")
fi

if [ "$SETUP_MODE" -eq 0 ] && [ "$INIT_MODE" -eq 0 ]; then
    EXE="$(realpath "$1")"
    shift
    EXE_DIR="$(dirname "$EXE")"

    # Se EXE_DIR è dentro il prefix, il --bind $WINEPFX già lo copre.
    # Non aggiungere un mount separato: sovrascriverebbe l'accesso in
    # scrittura del prefix (read-only su un path che era read-write).
    EXE_IN_PREFIX=0
    case "$EXE_DIR" in
        "$WINEPFX"/*) EXE_IN_PREFIX=1 ;;
    esac

    if [ "$INSTALL_MODE" -eq 1 ]; then
        # Modalità installazione: EXE_DIR in sola lettura (l'installer legge,
        # non scrive nella cartella sorgente). Z: abilitata ma tutti i mount
        # sono già ro-bind, quindi l'installer non può scrivere fuori dal prefix.
        if [ "$EXE_IN_PREFIX" -eq 0 ]; then
            BWRAP_ARGS+=(--ro-bind "$EXE_DIR" "$EXE_DIR")
        fi
        # Assicura che Z: esista per questa sessione (Wine la usa per risolvere
        # i path Unix dei file sorgente).
        if [ ! -e "$WINEPFX/dosdevices/z:" ]; then
            ln -sf / "$WINEPFX/dosdevices/z:"
        fi
        echo ">> Installazione in sandbox: $EXE"
        echo "   Rete: DISABILITATA"
        echo "   Home: nascosta"
        echo "   Z: abilitata (sola lettura - l'installer vede i file sorgente)"
        echo "   Filesystem: SOLO LETTURA (scrittura solo nel prefix)"
    else
        # Modalità gioco: EXE_DIR in sola lettura di default (il gioco non
        # deve scrivere nella sua cartella di installazione). SANDBOX_EXE_RW=1
        # permette scrittura per giochi che salvano i salvataggi accanto all'exe.
        # Se l'exe è dentro il prefix, il --bind $WINEPFX già gestisce l'accesso
        # (read-write), non serve un mount separato.
        if [ "$EXE_IN_PREFIX" -eq 1 ]; then
            echo ">> Avvio in sandbox: $EXE"
            echo "   (exe dentro il prefix - accesso gestito dal mount del prefix)"
        elif [ "$EXE_RW" -eq 1 ]; then
            BWRAP_ARGS+=(--bind "$EXE_DIR" "$EXE_DIR")
            echo ">> Avvio in sandbox: $EXE"
            echo "   Cartella gioco: ⚠️ scrittura abilitata"
        else
            BWRAP_ARGS+=(--ro-bind "$EXE_DIR" "$EXE_DIR")
            echo ">> Avvio in sandbox (read-only): $EXE"
            echo "   Cartella gioco: sola lettura"
        fi
        [ "$NET_ISOLATED" -eq 1 ] && echo "   Rete: DISABILITATA" || echo "   Rete: ⚠️ ABILITATA (compatibilità)"
        [ "$HIDE_HOME" -eq 1 ] && echo "   Home: nascosta" || echo "   Home: ⚠️ visibile (compatibilità)"
    fi
elif [ "$INIT_MODE" -eq 1 ]; then
    echo ">> Inizializzazione prefix in sandbox: $WINEPFX"
    echo "   Rete: DISABILITATA"
    [ "$HIDE_HOME" -eq 1 ] && echo "   Home: nascosta" || echo "   Home: ⚠️ visibile (compatibilità)"
    [ -n "$WINEARCH_VAL" ] && echo "   Architettura: $WINEARCH_VAL" || echo "   Architettura: WoW64 (predefinita)"
fi

# In modalità Wayland-puro: DISPLAY viene svuotato (definito prima di COMMON_ENV)
# per forzare Wine a scegliere il driver nativo Wayland (winewayland.drv) invece del
# driver X11. winex11.drv viene disabilitato sotto, dopo la definizione di COMMON_ENV.
if [ "$WAYLAND_ONLY" -eq 1 ]; then
    DISPLAY=""
fi

COMMON_ENV=(
    env
    WINEPREFIX="$WINEPFX"
    DISPLAY="${DISPLAY:-}"
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}"
    XDG_RUNTIME_DIR="/run/user/$(id -u)"
    PULSE_SERVER="unix:$PULSE_SOCKET"
)

# In modalità Wayland-puro: disabilitiamo esplicitamente winex11.drv così il gioco
# non può mai cadere su X11 nemmeno come fallback.
if [ "$WAYLAND_ONLY" -eq 1 ]; then
    if [ -n "${WINEDLLOVERRIDES:-}" ]; then
        COMMON_ENV+=(WINEDLLOVERRIDES="winex11.drv=d;${WINEDLLOVERRIDES}")
    else
        COMMON_ENV+=(WINEDLLOVERRIDES="winex11.drv=d")
    fi
fi
# XAUTHORITY: necessario per connettersi al server X (XWayland). Senza questo,
# Wine non può aprire finestre e fallisce con "Authorization required".
# In modalità Wayland-puro non serve (e non vogliamo esporre il file).
if [ "$WAYLAND_ONLY" -eq 0 ] && [ -n "${XAUTHORITY:-}" ]; then
    COMMON_ENV+=(XAUTHORITY="$XAUTHORITY")
    # Assicuriamoci che il file xauth sia visibile dentro la sandbox
    [ -f "$XAUTHORITY" ] && BWRAP_ARGS+=(--ro-bind-try "$XAUTHORITY" "$XAUTHORITY")
fi
# WINEARCH viene impostato SOLO in modalità --init: è l'unico momento in cui
# conta (creazione del prefix). Su un prefix già esistente, wine legge
# l'architettura registrata al suo interno. Forzarlo ad ogni esecuzione
# romperebbe i prefix su build Wine moderne "WoW64-only" (Wine 10+).
if [ "$INIT_MODE" -eq 1 ] && [ -n "$WINEARCH_VAL" ]; then
    COMMON_ENV+=(WINEARCH="$WINEARCH_VAL")
fi

if [ "$INIT_MODE" -eq 1 ]; then
    exec bwrap "${BWRAP_ARGS[@]}" "${COMMON_ENV[@]}" wineboot -u
    # Dopo wineboot, la GUI rimuove Z: se SANDBOX_DISABLE_ZDRIVE è attivo
elif [ "$SETUP_MODE" -eq 1 ]; then
    exec bwrap "${BWRAP_ARGS[@]}" "${COMMON_ENV[@]}" winetricks "$@"
else
    if [ "$NET_ISOLATED" -eq 1 ] && [ "$ALLOW_LOOPBACK" -eq 1 ]; then
        # Attiva l'interfaccia di loopback nel nuovo network namespace (nessun
        # accesso a internet, ma localhost funziona per giochi che usano
        # socket locali per componenti interni - es. alcuni motori audio/video)
        if [ "$VIRTUAL_DESKTOP" -eq 1 ]; then
            exec bwrap "${BWRAP_ARGS[@]}" "${COMMON_ENV[@]}" \
                sh -c 'ip link set lo up 2>/dev/null; cd "$0" && exec wine explorer /desktop=abandonscan,'"$VIRTUAL_DESKTOP_SIZE"' "$1" "${@:2}"' "$EXE_DIR" "$EXE" "$@"
        else
            exec bwrap "${BWRAP_ARGS[@]}" "${COMMON_ENV[@]}" \
                sh -c 'ip link set lo up 2>/dev/null; cd "$0" && exec wine "$1" "${@:2}"' "$EXE_DIR" "$EXE" "$@"
        fi
    else
        if [ "$VIRTUAL_DESKTOP" -eq 1 ]; then
            exec bwrap "${BWRAP_ARGS[@]}" "${COMMON_ENV[@]}" \
                sh -c 'cd "$0" && exec wine explorer /desktop=abandonscan,'"$VIRTUAL_DESKTOP_SIZE"' "$1" "${@:2}"' "$EXE_DIR" "$EXE" "$@"
        else
            exec bwrap "${BWRAP_ARGS[@]}" "${COMMON_ENV[@]}" \
                sh -c 'cd "$0" && exec wine "$1" "${@:2}"' "$EXE_DIR" "$EXE" "$@"
        fi
    fi
fi
